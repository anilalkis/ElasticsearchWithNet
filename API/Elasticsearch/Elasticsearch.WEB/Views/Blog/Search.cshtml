@model List<Blog>
@{
    ViewData["Title"] = "Search";
}

<div class="container">
    <div class="col-md-10 offset-md-1">
        <form method="post" asp-action="Search">
            <div class="mb-3">
                <label>Search(Title,Content)</label>
                <input name="searchText" class="form-control" />
            </div>
            <button type="submit" class="btn btn-primary">Search</button>
        </form>

        @if(!@Model.Any())
        {
            <div class="alert alert-info">Sonuç Bullunamamıştır</div>
        }
        else
        {
            <table class="table">
                <thead>
                    <tr>
                        <th>Id</th>
                        <th>Title</th>
                        <th>Content</th>
                        <th>UserId</th>
                        <th>Tags</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Id</td>
                            <td>@item.Title</td>
                            <td>@item.Content</td>
                            <td>@item.UserId</td>
                            <td>@string.Join(",",item.Tags)</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>
